# Arquivo de configuração do banco de dados
# Para usar o Supabase, use CURRENT_DATABASE=postgresql.

CURRENT_DATABASE=postgresql
DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_PORT=5432

# Para SQLite, use CURRENT_DATABASE=sqlite e defina:
# SQLITE_DATABASE_PATH=glicohealth.db

# Alternativamente, informe uma URI completa do Supabase:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
